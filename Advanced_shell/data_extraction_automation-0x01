#!/bin/bash

# JSON file containing Pokemon data
JSON_FILE="data.json"

# Extract data using jq
NAME=$(jq -r '.name' "$JSON_FILE" | sed 's/^\(.\)/\U\1/')
HEIGHT=$(jq -r '.height' "$JSON_FILE")
WEIGHT=$(jq -r '.weight' "$JSON_FILE")
TYPE=$(jq -r '.types[0].type.name' "$JSON_FILE" | sed 's/^\(.\)/\U\1/')

# Convert height from decimeters to meters (divide by 10) using awk
HEIGHT_M=$(echo "$HEIGHT" | awk '{printf "%.1f", $1/10}')

# Convert weight from hectograms to kilograms (divide by 10) using awk
WEIGHT_KG=$(echo "$WEIGHT" | awk '{printf "%.0f", $1/10}')

# Format and print the output
echo "${NAME} is of type ${TYPE}, weighs ${WEIGHT_KG}kg, and is ${HEIGHT_M}m tall."

