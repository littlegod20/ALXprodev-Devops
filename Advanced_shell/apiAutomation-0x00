#!/bin/bash

# Pokemon API URL for Pikachu
API_URL="https://pokeapi.co/api/v2/pokemon/pikachu"

# Output file
OUTPUT_FILE="data.json"

# Error file
ERROR_FILE="errors.txt"

# Make API request and save to data.json
# -s: silent mode (no progress bar)
# -S: show errors even in silent mode
# -f: fail silently on HTTP errors (returns error code)
# -k: skip SSL certificate verification (may be needed in some environments)
# --output: specify output file
curl -s -S -f -k --output "$OUTPUT_FILE" "$API_URL" 2>> "$ERROR_FILE"

# Check if curl was successful
if [ $? -eq 0 ] && [ -f "$OUTPUT_FILE" ] && [ -s "$OUTPUT_FILE" ]; then
    echo "Successfully retrieved Pikachu data and saved to $OUTPUT_FILE"
    exit 0
else
    # Request failed - log error
    ERROR_MSG="Failed to retrieve data from Pokemon API at $(date)"
    echo "$ERROR_MSG" >> "$ERROR_FILE"
    # Remove empty output file if it exists
    rm -f "$OUTPUT_FILE"
    exit 1
fi

