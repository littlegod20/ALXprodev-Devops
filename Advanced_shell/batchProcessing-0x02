#!/bin/bash

# Pokemon API base URL
API_BASE_URL="https://pokeapi.co/api/v2/pokemon"

# Directory to store Pokemon data
DATA_DIR="pokemon_data"

# List of Pokemon to fetch
POKEMON_LIST=("bulbasaur" "ivysaur" "venusaur" "charmander" "charmeleon")

# Delay between requests (in seconds) to avoid rate limiting
DELAY=1

# Create directory if it doesn't exist
mkdir -p "$DATA_DIR"

# Loop through each Pokemon
for pokemon in "${POKEMON_LIST[@]}"; do
    echo "Fetching data for $pokemon..."
    
    # API URL for this Pokemon
    API_URL="${API_BASE_URL}/${pokemon}"
    
    # Output file path
    OUTPUT_FILE="${DATA_DIR}/${pokemon}.json"
    
    # Make API request and save to file
    # -s: silent mode (no progress bar)
    # -S: show errors even in silent mode
    # -f: fail silently on HTTP errors (returns error code)
    # -k: skip SSL certificate verification (may be needed in some environments)
    # --output: specify output file
    curl -s -S -f -k --output "$OUTPUT_FILE" "$API_URL" 2>/dev/null
    
    # Check if curl was successful
    if [ $? -eq 0 ] && [ -f "$OUTPUT_FILE" ] && [ -s "$OUTPUT_FILE" ]; then
        echo "Saved data to ${OUTPUT_FILE} ✅"
    else
        echo "Failed to fetch data for $pokemon ❌"
        # Remove empty output file if it exists
        rm -f "$OUTPUT_FILE"
    fi
    
    # Add delay between requests to avoid rate limiting (except for the last Pokemon)
    if [ "$pokemon" != "${POKEMON_LIST[-1]}" ]; then
        sleep "$DELAY"
    fi
done

